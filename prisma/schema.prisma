generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  chats     Chat[]
}

model Chat {
  id        String   @id @default(cuid())
  message   String
  reply     String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  source    String
  tags      String[]
  fileName  String?  
  fileType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
