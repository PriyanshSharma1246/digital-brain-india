generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  chats         Chat[]
  conversations Conversation[]
}

model Chat {
  id        String   @id @default(cuid())
  message   String
  reply     String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
}

/// A persistent conversation (Phase 4). Each user owns many conversations,
/// each conversation owns ordered messages.
model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("New chat")
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
}

/// A single message inside a Conversation. Stored newest-last by createdAt.
model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // "user" | "assistant"
  content        String
  isError        Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  content   String
  category  String
  source    String
  tags      String[]
  fileName  String?  
  fileType  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A government document ingested into the RAG knowledge engine.
model KnowledgeDocument {
  id          String             @id @default(cuid())
  title       String
  category    String
  source      String
  content     String
  /// Filesystem path of the source markdown file (used to avoid duplicate imports).
  sourcePath  String?            @unique
  /// Hash of the raw content used to detect content changes on re-scan.
  contentHash String?
  createdAt   DateTime           @default(now())
  /// Last time the document was created or re-ingested.
  updatedAt   DateTime           @updatedAt
  chunks      KnowledgeChunk[]
}

/// A fixed-size chunk of a KnowledgeDocument ready for embedding and retrieval.
model KnowledgeChunk {
  id         String             @id @default(cuid())
  documentId String
  content    String
  /// Zero-based position of the chunk within its document (preserves order).
  chunkIndex Int
  /// Vector embedding. Kept nullable until the embedding provider is wired up.
  embedding  Json?
  createdAt  DateTime           @default(now())
  document   KnowledgeDocument  @relation(fields: [documentId], references: [id], onDelete: Cascade)
}
